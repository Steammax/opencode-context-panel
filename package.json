{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-context-panel",
  "version": "0.1.2",
  "description": "Claude-Code-style context breakdown panel for the OpenCode CLI sidebar",
  "type": "module",
  "license": "MIT",
  "author": "Steammax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steammax/opencode-context-panel.git"
  },
  "homepage": "https://github.com/Steammax/opencode-context-panel#readme",
  "bugs": {
    "url": "https://github.com/Steammax/opencode-context-panel/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "context",
    "tokens"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0",
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  }
}
